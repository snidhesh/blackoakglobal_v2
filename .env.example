RESEND_API_KEY=re_xxxxx
CONTACT_TO_EMAIL=enquiries@blackoakglobal.com
CONTACT_FROM_EMAIL=website@blackoakglobal.com
# Optional. Comma-separated list of CC recipients. Defaults to it@blackoak-re.com if unset.
CONTACT_CC_EMAIL=it@blackoak-re.com
INVESTOR_PORTAL_PASSWORD=change-me
INVESTOR_SESSION_SECRET=change-me-to-a-long-random-string
SITE_URL=https://blackoakglobal.com

# Cloudflare Turnstile — create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# In managed mode, add blackoakglobal.com and *.vercel.app as allowed hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — provision via Vercel Marketplace (auto-injects both vars) or https://console.upstash.com/
# Backs the /api/contact rate limiter so limits survive across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
